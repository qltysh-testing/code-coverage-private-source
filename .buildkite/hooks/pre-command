#!/bin/bash
set -euo pipefail

# Set up asdf
if [ -f "$HOME/.asdf/asdf.sh" ]; then
  source "$HOME/.asdf/asdf.sh"
elif [ -f "/opt/homebrew/opt/asdf/libexec/asdf.sh" ]; then
  source "/opt/homebrew/opt/asdf/libexec/asdf.sh"
fi

# Install Ruby version if .ruby-version file exists
if [ -f ".ruby-version" ]; then
  RUBY_VERSION=$(cat .ruby-version)
  echo "Setting up Ruby $RUBY_VERSION"

  # Add ruby plugin if not already added
  if ! asdf plugin list | grep -q "^ruby$"; then
    asdf plugin add ruby
  fi

  # Install Ruby version if not already installed
  if ! asdf list ruby | grep -q "$RUBY_VERSION"; then
    asdf install ruby "$RUBY_VERSION"
  fi

  asdf local ruby "$RUBY_VERSION"
fi